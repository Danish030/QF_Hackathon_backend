# ─────────────────────────────────────────────────────────────────
# Quran Foundation OAuth2 – Environment Variables
# Copy this file to .env and fill in your credentials.
# ─────────────────────────────────────────────────────────────────

# ── Client credentials (from https://api-docs.quran.foundation/request-access) ──
QF_CLIENT_ID=f5ff6f59-5951-4fd9-9c6d-af541ce1fba9

# Keep this ONLY on the backend. Never embed in a mobile app or browser.
# Omit only if Quran Foundation explicitly confirmed your client is public.
QF_CLIENT_SECRET=2LtKel5w3.KNXBlXCd-2dmcTL7

# ── Environment: "prelive" (default) | "production" ──
QF_ENV=prelive
// https://prelive-oauth2.quran.foundation
# ── App ──
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string-in-production
APP_BASE_URL=https://qf-hackathon-backend.vercel.app
